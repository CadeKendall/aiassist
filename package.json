{
  "name": "aiassist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local visual learning workbench powered by Codex",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
